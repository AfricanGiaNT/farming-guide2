PDF_PATH = r"C:\Users\Administratior\Downloads\agriculture-resourcs\agriculture-resourcs\Guide to Agriculture Production in Malawi 2021.pdf"

class Chapter3VarietyExtractor:
    """Extract varieties from Chapter 3 - Crop Production"""
    
    def __init__(self):
        self.supabase: Client = create_client(SUPABASE_URL, SUPABASE_KEY)
        self.pdf_path = PDF_PATH
        
        # Chapter 3 crop sections with their page ranges
        # Based on Guide to Agriculture Production in Malawi 2021 structure
        self.crop_sections = {
            # Cereals
            "maize": {"pages": (30, 49), "category": "cereal"},
            "rice": {"pages": (50, 64), "category": "cereal"},
            "sorghum": {"pages": (65, 74), "category": "cereal"},
            "wheat": {"pages": (75, 84), "category": "cereal"},
            "pearl millet": {"pages": (85, 94), "category": "cereal"},
            "finger millet": {"pages": (95, 104), "category": "cereal"},
            
            # Legumes
            "phaseolus beans": {"pages": (105, 119), "category": "legume"},
            "cowpea": {"pages": (120, 129), "category": "legume"},
            "groundnut": {"pages": (130, 144), "category": "legume"},
            "soyabean": {"pages": (145, 159), "category": "legume"},
            "bambara nut": {"pages": (160, 169), "category": "legume"},
            
            # Oilseeds
            "sunflower": {"pages": (170, 184), "category": "oilseed"},
            "sesame": {"pages": (185, 194), "category": "oilseed"},
            
            # Root and Tuber Crops
            "cassava": {"pages": (195, 209), "category": "tuber"},
            "sweet potato": {"pages": (210, 224), "category": "tuber"},
            "potato": {"pages": (225, 239), "category": "tuber"},
            
            # Vegetables
            "tomatoes": {"pages": (240, 254), "category": "vegetable"},
            "cabbage": {"pages": (255, 269), "category": "vegetable"},
            "onions": {"pages": (270, 284), "category": "vegetable"},
            
            # Cash Crops
            "cotton": {"pages": (285, 299), "category": "cash_crop"},
            "tobacco": {"pages": (300, 314), "category": "cash_crop"},
        }
    
    def is_valid_variety_name(self, name):
        """Check if extracted name is a valid variety name"""
        if not name or len(name.strip()) < 2:
            return False
        
        name = name.strip()
        
        # Too long (likely a sentence)
        if len(name) > 50:
            return False
        
        # Invalid keywords that indicate this is NOT a variety
        invalid_keywords = [
            'cost', 'margin', 'profit', 'income', 'total', 'average',
            'labour', 'labor', 'farming', 'management', 'revenue',
            'table', 'figure', 'source', 'note', 'appendix',
            'kg/ha', 'per hectare', 't/ha', 'yield per',
            'season', 'planting', 'harvesting', 'recommended',
            'botanic', 'scientific', 'common', 'local',
            'high yielding', 'early maturing', 'late maturing',
            'spacing', 'depth', 'length', 'width', 'height',
            'rainfed', 'irrigated', 'either', 'flower', 'fruit',
            'ministry', 'government', 'extension', 'research'
        ]
        
        name_lower = name.lower()
        for keyword in invalid_keywords:
            if keyword in name_lower:
                return False
        
        # Skip if it's all caps and long (likely a header)
        if name.isupper() and len(name) > 15:
            return False
        
        # Skip if it contains question marks
        if '?' in name:
            return False
        
        # Skip financial/measurement patterns
        invalid_patterns = [
            r'\d+\s*(kg|t|ha|%|mk|usd)',
            r'^\d+\s*-\s*\d+$',
            r'^\d+$',
        ]
        
        for pattern in invalid_patterns:
            if re.search(pattern, name, re.IGNORECASE):
                return False
        
        # Skip garbled text (multiple special characters)
        if name.count('*') > 2 or name.count('\n') > 1:
            return False
        
        return True
    
    def extract_varieties_from_tables(self, start_page, end_page):
        """Extract variety names from tables in page range"""
        varieties = set()
        
        with pdfplumber.open(self.pdf_path) as pdf:
            for page_num in range(start_page - 1, min(end_page, len(pdf.pages))):
                page = pdf.pages[page_num]
                tables = page.extract_tables()
                
                for table in tables:
                    if not table or len(table) < 2:
                        continue
                    
                    # Look for variety columns
                    # Usually in first few columns
                    for row in table[1:]:  # Skip header
                        if not row:
                            continue
                        
                        # Check first 3 columns for variety names
                        for cell in row[:3]:
                            if cell and self.is_valid_variety_name(str(cell)):
                                variety_name = str(cell).strip()
                                # Clean up the name
                                variety_name = re.sub(r'\s+', ' ', variety_name)
                                varieties.add(variety_name)
        
        return list(varieties)
    
    def extract_varieties_from_text(self, start_page, end_page):
        """Extract variety names from text patterns"""
        varieties = set()
        
        # Common patterns for variety mentions
        patterns = [
            r'(?:variety|varieties|cultivar|cultivars)[\s:]+([\w\s\-]+?)(?:\s+(?:is|are|and|,|\.))',
            r'([A-Z][a-z]+\s+\d+)',  # Pattern like "Makwacha 1"
            r'([A-Z]{2,}\s*\d+)',     # Pattern like "SC403", "MH18"
            r'([A-Z][a-z]+(?:\s+[A-Z][a-z]+)?)\s+(?:variety|cultivar)',
        ]
        
        with pdfplumber.open(self.pdf_path) as pdf:
            for page_num in range(start_page - 1, min(end_page, len(pdf.pages))):
                page = pdf.pages[page_num]
                text = page.extract_text()
                
                if not text:
                    continue
                
                for pattern in patterns:
                    matches = re.findall(pattern, text, re.IGNORECASE)
                    for match in matches:
                        if self.is_valid_variety_name(match):
                            variety_name = match.strip()
                            varieties.add(variety_name)
        
        return list(varieties)
    
    def get_crop_id(self, crop_name):
        """Get crop ID from Supabase"""
        try:
            result = self.supabase.table("crops").select("id").eq("crop_name", crop_name).execute()
            if result.data:
                return result.data[0]["id"]
            return None
        except Exception as e:
            print(f"  Error getting crop ID: {e}")
            return None
    
    def insert_variety(self, crop_id, crop_name, variety_name):
        """Insert variety into Supabase"""
        try:
            data = {
                "crop_id": crop_id,
                "crop_name": crop_name,
                "variety_name": variety_name,
                "type": "improved",
                "maturity_days": None,
                "yield_potential": "medium",
                "drought_tolerance": "moderate",
                "disease_resistance": [],
                "planting_months": [],
                "harvest_months": [],
                "min_rainfall_mm": 400,
                "max_rainfall_mm": 1000,
                "optimal_temperature_min": 18,
                "optimal_temperature_max": 30,
                "soil_requirements": "Well-drained fertile soils",
                "spacing_requirements": "As recommended in guide",
                "fertilizer_requirements": "Follow crop-specific recommendations",
                "pest_management": "Integrated pest management",
                "disease_management": "Use certified seed, practice rotation",
                "harvesting_guidelines": "Harvest at recommended maturity",
                "storage_requirements": "Proper drying and storage",
                "source_document": "Guide to Agriculture Production in Malawi 2021 - Chapter 3",
                "extraction_confidence": 0.90
            }
            
            self.supabase.table("varieties").insert(data).execute()
            return True
            
        except Exception as e:
            if "duplicate key" in str(e).lower() or "unique constraint" in str(e).lower():
                return False
            print(f"    Error inserting {variety_name}: {e}")
            return False
    
    def extract_crop_varieties(self, crop_name, config):
        """Extract varieties for a specific crop"""
        start_page, end_page = config["pages"]
        print(f"\n[{crop_name.upper()}] Extracting from pages {start_page}-{end_page}")
        
        # Extract from tables
        table_varieties = self.extract_varieties_from_tables(start_page, end_page)
        print(f"  Found {len(table_varieties)} varieties from tables")
        
        # Extract from text
        text_varieties = self.extract_varieties_from_text(start_page, end_page)
        print(f"  Found {len(text_varieties)} varieties from text")
        
        # Combine and deduplicate
        all_varieties = set(table_varieties + text_varieties)
        
        # Get crop ID
        crop_id = self.get_crop_id(crop_name)
        if not crop_id:
            print(f"  Crop '{crop_name}' not found in database!")
            return 0
        
        # Insert varieties
        inserted = 0
        for variety in sorted(all_varieties):
            if self.insert_variety(crop_id, crop_name, variety):
                print(f"    + {variety}")
                inserted += 1
        
        print(f"  Total inserted: {inserted} varieties")
        return inserted
    
    def extract_all(self):
        """Extract varieties for all crops in Chapter 3"""
        print("=" * 70)
        print("EXTRACTING VARIETIES FROM CHAPTER 3")
        print("Guide to Agriculture Production in Malawi 2021")
        print("=" * 70)
        
        total_inserted = 0
        results = {}
        
        for crop_name, config in self.crop_sections.items():
            try:
                count = self.extract_crop_varieties(crop_name, config)
                total_inserted += count
                results[crop_name] = count
            except Exception as e:
                print(f"\n  ERROR processing {crop_name}: {e}")
                results[crop_name] = 0
        
        return total_inserted, results
    
    def show_summary(self, results):
        """Show extraction summary"""
        print("\n" + "=" * 70)
        print("EXTRACTION SUMMARY")
        print("=" * 70)
        
        # Group by category
        by_category = defaultdict(list)
        for crop_name, count in results.items():
            category = self.crop_sections[crop_name]["category"]
            by_category[category].append((crop_name, count))
        
        total = sum(results.values())
        print(f"\nTotal varieties extracted: {total}")
        print(f"Crops processed: {len(results)}")
        
        print("\nBreakdown by category:")
        for category in sorted(by_category.keys()):
            crops = by_category[category]
            category_total = sum(c[1] for c in crops)
            print(f"\n  {category.upper()}: {category_total} varieties")
            for crop_name, count in sorted(crops):
                if count > 0:
                    print(f"    {crop_name}: {count}")

def main():
    print("\n" + "=" * 70)
    print("CHAPTER 3 VARIETY EXTRACTION")
    print("Guide to Agriculture Production in Malawi 2021")
    print("=" * 70 + "\n")
    
    extractor = Chapter3VarietyExtractor()
    
    # Extract all varieties
    total, results = extractor.extract_all()
    
    # Show summary
    extractor.show_summary(results)
    
    print("\n" + "=" * 70)
    print(f"COMPLETE! Extracted {total} varieties from Chapter 3")
    print("All varieties properly associated with their crops")
    print("=" * 70 + "\n")

if __name__ == "__main__":
    main()
