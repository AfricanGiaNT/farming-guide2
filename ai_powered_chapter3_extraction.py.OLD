#!/usr/bin/env python3
"""
AI-Powered Variety Extraction from Chapter 3
Uses GPT-4 to intelligently extract ONLY real variety names from tables and text
Focused on Guide to Agriculture Production in Malawi 2021
"""

import os
import pdfplumber
from openai import OpenAI
from supabase import create_client, Client
import json
import time

# Configuration
SUPABASE_URL = "https://itcsdacjopedjcyhqyki.supabase.co"
SUPABASE_KEY = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Iml0Y3NkYWNqb3BlZGpjeWhxeWtpIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NjA5ODg1MDUsImV4cCI6MjA3NjU2NDUwNX0.659SJ6mcDpeyq7mtduMneh-h9gz3vSFA-2F-oVlVJmk"

PDF_PATH = r"C:\Users\Administratior\Downloads\agriculture-resourcs\agriculture-resourcs\Guide to Agriculture Production in Malawi 2021.pdf"

class AIVarietyExtractor:
    """AI-powered variety extraction"""
    
    def __init__(self):
        self.supabase: Client = create_client(SUPABASE_URL, SUPABASE_KEY)
        
        # Load OpenAI API key
        openai_key = os.getenv('OPENAI_API_KEY')
        if not openai_key:
            config_path = os.path.join(os.path.dirname(__file__), "config", "openai_key.env")
            if os.path.exists(config_path):
                with open(config_path, 'r') as f:
                    for line in f:
                        if line.startswith('OPENAI_API_KEY='):
                            openai_key = line.split('=', 1)[1].strip()
                            break
        
        self.openai_client = OpenAI(api_key=openai_key)
        self.pdf_path = PDF_PATH
        
        # Focused crop list with specific table page locations
        self.crops = {
            "maize": {"pages": (45, 47), "table_keyword": "maize varieties"},
            "rice": {"pages": (54, 60), "table_keyword": "rice varieties"},
            "sorghum": {"pages": (69, 71), "table_keyword": "sorghum varieties"},
            "phaseolus beans": {"pages": (106, 108), "table_keyword": "bean varieties"},
            "groundnut": {"pages": (133, 136), "table_keyword": "groundnut varieties"},
            "soyabean": {"pages": (150, 156), "table_keyword": "soybean varieties"},
            "cassava": {"pages": (197, 199), "table_keyword": "cassava varieties"},
            "sweet potato": {"pages": (211, 217), "table_keyword": "sweet potato varieties"},
            "potato": {"pages": (226, 230), "table_keyword": "potato varieties"},
            "tomatoes": {"pages": (241, 247), "table_keyword": "tomato varieties"},
            "cotton": {"pages": (290, 292), "table_keyword": "cotton varieties"},
            "tobacco": {"pages": (305, 307), "table_keyword": "tobacco varieties"},
        }
    
    def extract_text_from_pages(self, start_page, end_page):
        """Extract text from specific pages"""
        text = ""
        with pdfplumber.open(self.pdf_path) as pdf:
            for page_num in range(start_page - 1, min(end_page, len(pdf.pages))):
                page = pdf.pages[page_num]
                page_text = page.extract_text()
                if page_text:
                    text += f"\n--- Page {page_num + 1} ---\n{page_text}\n"
        return text
    
    def extract_varieties_with_ai(self, crop_name, text_content):
        """Use GPT-4 to extract ONLY real variety names"""
        
        prompt = f"""You are extracting crop variety names from an agricultural guide for Malawi.

Extract ONLY actual {crop_name} variety names from the text below.

RULES:
1. Extract ONLY variety names (e.g., "SC403", "Napilira", "Chalimbana")
2. DO NOT extract: measurements, numbers, table headers, financial terms, generic descriptions
3. DO NOT extract: "2 heaps", "10 pits", "Total", "Average", "Cost", etc.
4. DO NOT extract: geographic locations, seasons, or farming practices
5. Look for variety tables that list cultivar/variety names
6. Each variety should be a proper name, not a description

Return ONLY a JSON array of variety names, nothing else.
Example: ["SC403", "SC419", "DK8031"]

TEXT TO ANALYZE:
{text_content[:8000]}

Return JSON array only:"""
        
        try:
            response = self.openai_client.chat.completions.create(
                model="gpt-4",
                messages=[
                    {"role": "system", "content": "You are an expert at extracting crop variety names from agricultural documents. You only extract real variety/cultivar names, never measurements, descriptions, or table headers."},
                    {"role": "user", "content": prompt}
                ],
                temperature=0.1,
                max_tokens=1000
            )
            
            ai_response = response.choices[0].message.content.strip()
            
            # Clean response
            if ai_response.startswith("```json"):
                ai_response = ai_response[7:]
            if ai_response.startswith("```"):
                ai_response = ai_response[3:]
            if ai_response.endswith("```"):
                ai_response = ai_response[:-3]
            
            ai_response = ai_response.strip()
            
            # Parse JSON
            varieties = json.loads(ai_response)
            
            if isinstance(varieties, list):
                return varieties
            else:
                return []
                
        except Exception as e:
            print(f"  AI extraction error: {e}")
            return []
    
    def get_crop_id(self, crop_name):
        """Get crop ID from Supabase"""
        try:
            result = self.supabase.table("crops").select("id").eq("crop_name", crop_name).execute()
            if result.data:
                return result.data[0]["id"]
            return None
        except Exception as e:
            print(f"  Error getting crop ID: {e}")
            return None
    
    def insert_variety(self, crop_id, crop_name, variety_name):
        """Insert variety into Supabase"""
        try:
            data = {
                "crop_id": crop_id,
                "crop_name": crop_name,
                "variety_name": variety_name,
                "type": "improved",
                "maturity_days": None,
                "yield_potential": "medium",
                "drought_tolerance": "moderate",
                "disease_resistance": [],
                "planting_months": [],
                "harvest_months": [],
                "min_rainfall_mm": 400,
                "max_rainfall_mm": 1000,
                "optimal_temperature_min": 18,
                "optimal_temperature_max": 30,
                "soil_requirements": "Well-drained fertile soils",
                "spacing_requirements": "As recommended",
                "fertilizer_requirements": "Follow recommendations",
                "pest_management": "IPM practices",
                "disease_management": "Use certified seed",
                "harvesting_guidelines": "Harvest at maturity",
                "storage_requirements": "Dry storage",
                "source_document": "Guide to Agriculture Production Malawi 2021 - Chapter 3",
                "extraction_confidence": 0.95
            }
            
            self.supabase.table("varieties").insert(data).execute()
            return True
            
        except Exception as e:
            if "duplicate key" in str(e).lower():
                return False
            return False
    
    def extract_crop_varieties(self, crop_name, config):
        """Extract varieties for one crop using AI"""
        start_page, end_page = config["pages"]
        print(f"\n[{crop_name.upper()}] Extracting from pages {start_page}-{end_page}")
        
        # Extract text from pages
        text = self.extract_text_from_pages(start_page, end_page)
        
        if not text.strip():
            print(f"  No text extracted")
            return 0
        
        # Use AI to extract varieties
        print(f"  Analyzing with AI...")
        varieties = self.extract_varieties_with_ai(crop_name, text)
        print(f"  AI found {len(varieties)} varieties")
        
        if not varieties:
            return 0
        
        # Get crop ID
        crop_id = self.get_crop_id(crop_name)
        if not crop_id:
            print(f"  Crop not found in database")
            return 0
        
        # Insert varieties
        inserted = 0
        for variety_name in varieties:
            if self.insert_variety(crop_id, crop_name, variety_name):
                print(f"    + {variety_name}")
                inserted += 1
        
        print(f"  Inserted: {inserted} varieties")
        
        # Small delay to avoid rate limits
        time.sleep(2)
        
        return inserted
    
    def extract_all(self):
        """Extract varieties for all crops"""
        print("=" * 70)
        print("AI-POWERED VARIETY EXTRACTION FROM CHAPTER 3")
        print("Using GPT-4 for intelligent extraction")
        print("=" * 70)
        
        total = 0
        results = {}
        
        for crop_name, config in self.crops.items():
            try:
                count = self.extract_crop_varieties(crop_name, config)
                total += count
                results[crop_name] = count
            except Exception as e:
                print(f"\n  ERROR: {e}")
                results[crop_name] = 0
        
        print("\n" + "=" * 70)
        print("EXTRACTION COMPLETE")
        print("=" * 70)
        print(f"\nTotal varieties extracted: {total}")
        print("\nBreakdown by crop:")
        for crop_name, count in results.items():
            if count > 0:
                print(f"  {crop_name}: {count} varieties")
        
        return total

def main():
    print("\nAI-POWERED VARIETY EXTRACTION")
    print("Chapter 3 - Guide to Agriculture Production in Malawi 2021\n")
    
    extractor = AIVarietyExtractor()
    total = extractor.extract_all()
    
    print(f"\n{'=' * 70}")
    print(f"SUCCESS! Extracted {total} accurate varieties")
    print(f"{'=' * 70}\n")

if __name__ == "__main__":
    main()
